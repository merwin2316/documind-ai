# ============================================
# DocuMind AI — Environment Variables Template
# ============================================
# cp .env.example .env
# The app works with JUST the defaults below!
# ============================================

# ============================================
# LLM PROVIDER (Required)
# ============================================
# Provider: "ollama" (local, free) or "groq" (free cloud)
MODEL_PROVIDER=ollama

# Ollama — local LLM server (default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Groq — free cloud fallback (optional)
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================
# DATABASE (SQLite default — no setup needed)
# ============================================
DATABASE_URL=sqlite:///./documind.db

# ============================================
# VECTOR DATABASE
# ============================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ============================================
# APPLICATION
# ============================================
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
ADMIN_SECRET_KEY=dev_secret
FRONTEND_URL=http://localhost:3000

# ============================================
# FILE STORAGE
# ============================================
STORAGE_BUCKET=documents
LOCAL_STORAGE_PATH=./storage

# ============================================
# AUTHENTICATION & SUPABASE
# ============================================
# Supabase project configuration (Get at: https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=authenticated

# Set to True only for explicit local standalone testing without Supabase
ALLOW_DEV_AUTH=False

# Set to True to allow the destructive /reset endpoint in development
ENABLE_RESET_ENDPOINT=False

# ============================================
# OPTIONAL: RAG Tuning
# ============================================
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
# TOP_K_RETRIEVAL=10
