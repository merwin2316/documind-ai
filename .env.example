# ============================================
# DocuMind AI — Environment Variables Template
# ============================================
# cp .env.example .env
# The app works with JUST the defaults below!
# ============================================

# ============================================
# LLM PROVIDER (Required)
# ============================================
# Provider: "ollama" (local, free) or "groq" (free cloud)
MODEL_PROVIDER=ollama

# Ollama — local LLM server (default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Groq — free cloud fallback (optional)
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================
# DATABASE (SQLite default — no setup needed)
# ============================================
DATABASE_URL=sqlite:///./documind.db

# ============================================
# VECTOR DATABASE
# ============================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ============================================
# APPLICATION
# ============================================
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
ADMIN_SECRET_KEY=dev_secret
FRONTEND_URL=http://localhost:3000

# ============================================
# FILE STORAGE
# ============================================
STORAGE_BUCKET=documents
LOCAL_STORAGE_PATH=./storage

# ============================================
# OPTIONAL: Supabase (for production auth/storage)
# ============================================
# Uncomment these to enable Supabase mode:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-role-key
# SUPABASE_JWT_SECRET=your-jwt-secret

# ============================================
# OPTIONAL: RAG Tuning
# ============================================
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
# TOP_K_RETRIEVAL=10
